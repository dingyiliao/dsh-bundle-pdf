{
  "name": "@local/dsh-pdf",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "PDF reading, annotations, navigation and selection translation for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingyiliao/dsh-bundle-pdf.git"
  },
  "homepage": "https://github.com/dingyiliao/dsh-bundle-pdf#readme",
  "bugs": {
    "url": "https://github.com/dingyiliao/dsh-bundle-pdf/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./native": "./dist/native-provider.js",
    "./ocr-host": {
      "types": "./dist/types/host/ocr-plugin.d.ts",
      "import": "./dist/ocr-host.js"
    },
    "./image-host": {
      "types": "./dist/types/host/image-understanding-plugin.d.ts",
      "import": "./dist/image-host.js"
    },
    "./client": "./dist/client.js",
    "./ocr": {
      "types": "./dist/types/ocr/index.d.ts",
      "import": "./dist/ocr.js"
    },
    "./translation": {
      "types": "./dist/types/translation/index.d.ts",
      "import": "./dist/translation.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "SPEC.md",
    "docs/UX_TYPOGRAPHY.md",
    "docs/AI_READER_TOOLS.md",
    "docs/ARCHITECTURE_V2.md",
    "PERFORMANCE.md",
    "NATIVE_V1.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "bench": "node --import tsx bench/run.ts",
    "bench:corpus": "node --import tsx bench/corpus.ts",
    "bench:browser": "node --import tsx bench/browser.ts",
    "bench:compare": "node --import tsx bench/compare.ts",
    "arch:report": "node scripts/architecture-metrics.mjs",
    "typecheck:bench": "tsc --noEmit --project tsconfig.bench.json",
    "build": "node scripts/build.mjs",
    "native:build": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run build && node scripts/run-node-tests.mjs",
    "test:coverage:node": "npm run build && node scripts/run-node-tests.mjs --coverage",
    "test:coverage:native": "node scripts/coverage-native.mjs",
    "test:coverage:project": "node scripts/coverage-project.mjs",
    "test:coverage": "npm run test:coverage:project",
    "test:web": "npm run build && vitest run --config vitest.web.config.ts",
    "check": "npm run typecheck && npm run typecheck:tests && npm run typecheck:bench && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "pdf-lib": "1.17.1",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.0-rc.2",
    "@deepseek-ai/dsh-loader-smoke": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.12",
    "jsdom": "29.1.1",
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
