{
  "name": "@local/dsh-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDF reader, annotations, navigation and pluggable OCR for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingyiliao/dsh-bundle-pdf.git"
  },
  "homepage": "https://github.com/dingyiliao/dsh-bundle-pdf#readme",
  "bugs": {
    "url": "https://github.com/dingyiliao/dsh-bundle-pdf/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./ocr": {
      "types": "./dist/types/ocr/index.d.ts",
      "import": "./dist/ocr.js"
    },
    "./translation": {
      "types": "./dist/types/translation/index.d.ts",
      "import": "./dist/translation.js"
    },
    "./native-dictionary": {
      "types": "./dist/types/client/native-dictionary.d.ts",
      "import": "./dist/native-dictionary.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "SPEC.md",
    "PERFORMANCE.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "bench": "node --import tsx bench/run.ts",
    "bench:corpus": "node --import tsx bench/corpus.ts",
    "bench:browser": "node --import tsx bench/browser.ts",
    "bench:compare": "node --import tsx bench/compare.ts",
    "typecheck:bench": "tsc --noEmit --project tsconfig.bench.json",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.test.json",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:web": "npm run build && vitest run --config vitest.web.config.ts",
    "prepare": "npm run build",
    "check": "npm run typecheck && npm run typecheck:tests && npm run typecheck:bench && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.1",
    "@deepseek-ai/dsh-loader-smoke": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.12",
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
