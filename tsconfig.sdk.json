{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist/types"
  },
  "include": [
    "src/ocr/index.ts",
    "src/translation/index.ts",
    "src/embedding/index.ts",
    "src/host/ocr-plugin.ts",
    "src/host/image-understanding-plugin.ts",
    "src/modules/capabilities/index.ts",
    "src/modules/engines/index.ts"
  ]
}
