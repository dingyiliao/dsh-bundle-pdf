{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist/types"
  },
  "include": [
    "src/engines/ocr/sdk/index.ts",
    "src/engines/translation/sdk/index.ts",
    "src/engines/embedding/sdk/index.ts",
    "src/plugins/public/ocr-host.ts",
    "src/plugins/public/image-understanding-host.ts",
    "src/capabilities/index.ts",
    "src/engines/spi/index.ts"
  ]
}
